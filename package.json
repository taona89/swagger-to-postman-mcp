{
  "name": "swagger-to-postman-mcp",
  "version": "2.0.0",
  "description": "MCP server and CLI that generate Postman test suites (positive, negative, contract, data-driven) from OpenAPI 3.x and Swagger 2.0 specs",
  "main": "index.js",
  "type": "module",
  "bin": {
    "swagger-to-postman-mcp": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "generate": "node generate.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "lint": "eslint .",
    "check": "npm run lint && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openapi",
    "swagger",
    "postman",
    "api-testing",
    "test-generation",
    "automation"
  ],
  "author": "API Test Team",
  "license": "MIT",
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "js-yaml": "^4.1.0",
    "randexp": "^0.5.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.1"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "index.js",
    "generate.js",
    "src/",
    "swagger/",
    "README.md",
    "LICENSE"
  ]
}
